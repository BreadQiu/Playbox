{
  "name": "playbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @playbox/blocky-24",
    "test": "npm run test --workspace @playbox/blocky-24 --",
    "test:e2e": "npm run test:e2e --workspace @playbox/blocky-24",
    "build": "node scripts/build-pages.mjs",
    "preview": "node scripts/serve-pages.mjs",
    "verify:pages": "node scripts/verify-pages.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
